# ============================================================================
#  Deepsea/.env   - copy tu file nay:   cp .env.example .env
#  (hoac chay:  bash nt.sh init  - tu tao cho ca 5 project)
#
#  .env DA nam trong .gitignore cua repo -> khong bi day len git. An toan.
# ============================================================================

TZ=Asia/Ho_Chi_Minh

# --- Cong ------------------------------------------------------------------
# 100 = dung cong ma run.bat cua repo dang dung, giu nguyen cho quen tay.
#
# HAI DIEU CAN BIET VE CONG 100:
#  1. Cong duoi 1024 la cong "dac quyen" tren Linux. Trong Docker khong sao
#     (tien trinh trong container chay quyen root, va Docker daemon mo cong
#     ho o phia host), nhung neu sau nay chay truc tiep bang systemd voi
#     user thuong thi se bi "Permission denied".
#  2. Trinh duyet CHAN mot loat cong "khong an toan". Cong 101, 102, 103, 104
#     nam trong danh sach chan cua Chrome; 100 thi KHONG. Tuc la 100 dung
#     duoc, nhung sat ngay canh vung cam - doi cong thi tranh 101-104,
#     neu khong Chrome bao ERR_UNSAFE_PORT ma khong giai thich gi them.
DEEPSEA_PORT=100

# --- SQL Server ------------------------------------------------------------
# Dung chung may chu voi HRM / Incentive / DaiDuong / Summary.
# DeepSea doc 3 database tren cung may nay: HR, INCENTIVE, DW
# (ten database duoc truyen vao tung cau lenh trong code, khong khai o day).
#
# Tren may cu, ba gia tri nay nam o BIEN MOI TRUONG HE THONG cua Windows
# (Control Panel -> Environment Variables) chu khong o file nao - vi the
# clone code ve may moi la mat, va run.bat van chay duoc ma khong can .env.
DB_SERVER=172.16.60.100
DB_UID=deepsea
# Boc nhay don: docker compose dien giai ky tu $ trong file .env thanh ten
# bien. Mat khau hien tai khong co $ nhung boc san cho lan doi sau khoi quen.
DB_PASSWORD='Namthuan@2025#'

# Chi dung cho trang "Ke hoach" (views/PPC.py -> db/base.py -> core/config.py).
# Cac trang khac truyen ten database truc tiep trong cau query.
DATABASE_1=DW

# --- Tuy chon: kho pip noi bo / gan hon --------------------------------------
# De trong thi dung pypi.org chinh thuc.
# PIP_INDEX_URL=https://pypi.org/simple
